# ---------------------------------------------------------------------------
# Bell Cell EduSuite - environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Deployment runs on plain Node 22 + PostgreSQL 16. There is no Docker and
# no container runtime anywhere in the stack - see docs/deployment.md.
# ---------------------------------------------------------------------------

# PostgreSQL 16 connection string. On the server this points at a local
# socket or 127.0.0.1; the database is never exposed to the network.
DATABASE_URL="postgresql://bellcell:bellcell@localhost:5432/bellcell?schema=public"

# Session lifetime in hours. 12 is one working day.
#
# There is deliberately NO session secret to set. A session cookie carries an
# opaque 32-byte random token and nothing else; the server stores only a
# SHA-256 of it, so there is no payload to sign and a database leak does not
# hand over live sessions. (An earlier version of this file asked for a
# SESSION_SECRET that no code ever read - a setting nobody uses is worse than
# no setting, because the next person assumes it protects something.)
SESSION_TTL_HOURS="12"

# Public base URL, used on printed documents and in links.
APP_URL="http://localhost:3000"

# Institute display name shown in the UI and on printed documents.
INSTITUTE_NAME="Bell Cell"

# Port the Node server listens on. nginx proxies to this; it is not public.
PORT="3000"
HOSTNAME="127.0.0.1"

# ---------------------------------------------------------------------------
# Notifications - left unconfigured by default. See docs/open-questions.md #6.
# SMS in India additionally requires DLT sender-ID/template registration in
# the institute's own name before any transactional SMS can be delivered,
# which takes weeks and must be started well before go-live.
# ---------------------------------------------------------------------------
NOTIFY_EMAIL_ENABLED="false"
NOTIFY_SMS_ENABLED="false"
