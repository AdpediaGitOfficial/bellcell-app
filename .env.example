# ---------------------------------------------------------------------------
# Bell Cell EduSuite - environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL 16 connection string.
DATABASE_URL="postgresql://bellcell:bellcell@localhost:5432/bellcell?schema=public"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime in hours.
SESSION_TTL_HOURS="12"

# Public base URL of the app (used in emails/links).
APP_URL="http://localhost:3000"

# Institute display name shown in the UI and on printed documents.
INSTITUTE_NAME="Bell Cell"

# ---------------------------------------------------------------------------
# Notifications - left unconfigured by default. See docs/open-questions.md:
# SMS in India additionally requires DLT sender-ID/template registration in
# the institute's own name before any transactional SMS can be delivered.
# ---------------------------------------------------------------------------
NOTIFY_EMAIL_ENABLED="false"
NOTIFY_SMS_ENABLED="false"
